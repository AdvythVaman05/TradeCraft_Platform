# =================================================================
# TradeCraft Platform - Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# =================================================================

# 1. SECRET MANAGEMENT (Required: Must be a long, random secret key at least 50 chars)
SECRET_KEY=replace-with-a-generated-secret-key-at-least-50-characters-long

# Optional dedicated JWT signing key (defaults to SECRET_KEY if omitted)
JWT_SECRET_KEY=replace-with-a-dedicated-jwt-secret-key-or-leave-blank
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# 2. DEBUG & HOST SECURITY
# Set DEBUG=False for production deployments
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tradecraft.example.com

# 3. CORS & CSRF TRUSTED ORIGINS
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tradecraft.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tradecraft.example.com
CSRF_COOKIE_HTTPONLY=False

# 4. DATABASE CONFIGURATION
# Set USE_SQLITE=true for local development with SQLite
USE_SQLITE=false
NEON_URL=postgresql://user:password@host/dbname?sslmode=require

# 5. HTTPS & PRODUCTION SECURITY HEADERS
# Enable these for HTTPS production deployments
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
